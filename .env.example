# Copia este fichero como .env en la raíz del repo y cambia TODOS los valores "change-me".
# docker compose lo carga en todos los servicios (env_file). No subas nunca el .env real.
# CI: .github/scripts/check_env_example.py falla si falta o sobra alguna variable.

# --- API (NestJS) -------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Orígenes permitidos por CORS, separados por comas (el frontend).
CORS_ORIGINS=http://localhost:5173
# URL pública de la API con la que se construyen las URLs firmadas de los ficheros.
API_PROTOCOL=http
API_HOST=localhost
API_PORT=3000

# --- Autenticación -------------------------------------------------------------
# Secreto largo y aleatorio (p. ej. `openssl rand -hex 32`). También firma las URLs de ficheros y progreso.
JWT_SECRET=change-me
JWT_EXPIRATION=1d

# --- PostgreSQL ------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=atmosblock
DB_PASSWORD=change-me
DB_NAME=atmosblock

# --- RabbitMQ ------------------------------------------------------------------
# Credenciales con las que se crea el broker (imagen rabbitmq) y que usan los módulos de Python.
RABBITMQ_DEFAULT_USER=atmosblock
RABBITMQ_DEFAULT_PASS=change-me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# La API se conecta con una URL que repite las credenciales anteriores.
RABBITMQ_URL=amqp://atmosblock:change-me@rabbitmq:5672
RABBITMQ_CONFIG_QUEUE=config_queue
RABBITMQ_RESULT_QUEUE=results_queue
RABBITMQ_PROGRESS_QUEUE=progress_queue

# --- MinIO ---------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_USER=atmosblock
MINIO_PASSWORD=change-me-min-8-chars
MINIO_BUCKET=atmosblock-results

# --- Copernicus CDS (configurador, descarga de ERA5) ----------------------------
# La clave personal de https://cds.climate.copernicus.eu (perfil de usuario). Se lee en ejecución, nunca en la imagen.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=change-me
